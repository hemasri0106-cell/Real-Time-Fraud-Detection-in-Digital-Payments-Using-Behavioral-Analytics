# Copy this file to .env and replace placeholders with local credentials.
JWT_SECRET_KEY=replace_with_a_random_secret
OTP_HASH_SECRET=replace_with_a_separate_random_secret

# Gmail SMTP. SMTP_PASSWORD must be a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM=your-address@gmail.com
